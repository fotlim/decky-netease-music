{
  "name": "decky-netease-music",
  "version": "1.0.0",
  "description": "网易云音乐 Decky Loader 插件 - 简洁、高效、低占用",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "qrcode-generator": "1.4.4",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "rollup": "^4.62.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
